# IncuBrix Distribution Network Configuration

# Application
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
SIMULATION_MODE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./incubrix.db
SYNC_DATABASE_URL=sqlite:///./incubrix.db

# Security & HMAC
INCUBRIX_WEBHOOK_SECRET=incubrix_dev_secret_key_change_in_prod_32bytes
CALLBACK_SIGNATURE_HEADER=X-IncuBrix-Signature

# Platform URLs & Mock Server
MOCK_SERVER_URL=http://localhost:8001
DISCOURSE_BASE_URL=http://localhost:8001/discourse
LEMMY_BASE_URL=http://localhost:8001/lemmy
DEVTO_BASE_URL=http://localhost:8001/devto
GHOST_BASE_URL=http://localhost:8001/ghost
WEBHOOK_TEST_URL=http://localhost:8001/webhook

# Credentials (Optional / Local Dev / Mock)
DISCOURSE_API_KEY=test_discourse_api_key
DISCOURSE_API_USERNAME=incubrix_bot
LEMMY_AUTH_TOKEN=jwt_test_lemmy_token
DEVTO_API_KEY=test_devto_api_key
GHOST_ADMIN_API_KEY=64f1a2b3c4d5e6f7a8b9c0d1:e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1

# Storage (Local / MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./outputs/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incubrix-evidence
