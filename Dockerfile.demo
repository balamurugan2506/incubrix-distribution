# Dockerfile.demo: Single-container Demo Deployment
# Runs IncuBrix Distribution Network API + mock platforms in simulation mode
# Enforces non-root user execution for container security

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SIMULATION_MODE=true \
    APP_ENV=production \
    PORT=8000 \
    HOST=0.0.0.0 \
    DATABASE_URL=sqlite+aiosqlite:////tmp/incubrix.db

WORKDIR /app

# Install security updates and build requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root unprivileged service user
RUN useradd -m -u 1000 -s /bin/bash incubrix

# Install dependencies as cached layer
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy repository code with non-root ownership
COPY --chown=incubrix:incubrix . .

# Ensure storage and evidence directories exist and are writable
RUN mkdir -p /app/outputs/evidence /app/outputs/storage /app/data && \
    chown -R incubrix:incubrix /app /app/outputs /app/data

# Switch to non-root user
USER incubrix

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "scripts/run_demo.py"]
